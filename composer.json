{
    "name": "debug404/laravel-ranker",
    "description": "High-performance Eloquent drag-and-drop item sorting and reordering package for Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "debug404",
            "email": "memorytemp5@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/database": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/routing": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/http": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ranker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ranker\\RankerServiceProvider"
            ],
            "aliases": {
                "Ranker": "Ranker\\Facades\\Ranker"
            }
        }
    }
}